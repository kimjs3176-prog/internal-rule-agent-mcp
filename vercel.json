{
  "version": 2,
  "regions": [
    "icn1"
  ],
  "git": {
    "deploymentEnabled": {
      "ledger-data": false
    }
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{assets/**,certs/**,mcp_server/**,regulations/**,samples/**,org_config.json,regulations_manifest.json,regulations_vectors.json,regulations_vectors.bin}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/regulations/(.*)",
      "dest": "/regulations/$1",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'none'; object-src 'none'; frame-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "/mcp/?",
      "dest": "/api/index.py"
    },
    {
      "src": "/\\.well-known/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      }
    }
  ]
}
